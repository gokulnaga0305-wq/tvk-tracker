# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (preferred - accepts UPI in India)
OPENROUTER_API_KEY=sk-or-v1-...

# Apify
APIFY_API_TOKEN=your-apify-token

# Optional: Google Fact Check Tools API (for related fact-check attachment)
GOOGLE_FACT_CHECK_API_KEY=

# Optional: Hugging Face Inference API (for AI-image detection)
HUGGINGFACE_API_KEY=

# App
GOVT_START_DATE=2026-05-11
GOVT_NAME=TVK
ADMIN_SECRET=change-this-secret

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
